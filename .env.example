# Set to "production" to read MONGODB_URL and suppress stack traces on the
# error page. Any other value uses the local database and loads this file
# via dotenv.
NODE_ENV=development

# HTTP port. Defaults to 4000 if unset.
PORT=4000

# Signing secret for express-session. Use a long random string.
# There is no fallback in code, so sessions break if this is empty.
SESSION_SECRET=

# MongoDB connection string. Only read when NODE_ENV=production.
# Outside production the app connects to the same local database the
# storefront uses: mongodb://127.0.0.1:27017/BookSellingApp
MONGODB_URL=
