<div class="modal fade satus-comment-modal" id="statusCommentModal" data-bs-backdrop="static" data-bs-keyboard="false"
    tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header mb-3">
                <h1 class="modal-title satus-comment-title fs-5" id="staticBackdropLabel">Enter Reason</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form class="needs-validation order-status-form">
                        <p class="text-center mb-4" id="otpSendStatus">Write Your Reason To Change Status</p>
                        <input class="visually-hidden" type="text" name="order-status-value" id="orderStatusValue">
                        <input class="visually-hidden" type="text" name="order-id" id="orderId">
                        <div class="row justify-content-center">
                            <div class="col-12 form-floating mb-4">
                                <textarea class="form-control order-status-form-input" placeholder="Write comment here" id="statusComment" style="height: 100px"></textarea>
                                <label for="statusComment" class="ms-3">Write comment here</label>
                            </div>
                            <div class="col-12 form-floating mb-4 d-none" id="paymentIdContainer">
                                <input type="text" class="form-control payment-id-form-input" placeholder="Payment Id" id="paymentId" value="<%=  %> "></input>
                                <label for="paymentId" class="ms-3">Payment Id</label>
                            </div>
                        </div>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-primary submit-order-status-comment-btn">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
